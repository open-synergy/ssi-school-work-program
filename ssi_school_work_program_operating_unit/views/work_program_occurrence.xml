<odoo>
<record id="work_program_occurrence_view_search_ou" model="ir.ui.view">
    <field name="name">work_program_occurrence search - operating unit</field>
    <field name="model">work_program_occurrence</field>
    <field
            name="inherit_id"
            ref="ssi_school_work_program.work_program_occurrence_view_search"
        />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='work_program_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
            <xpath expr="//filter[@name='group_by_work_program_id']" position="after">
                <filter
                        name="group_by_operating_unit_id"
                        string="Operating Unit"
                        context="{'group_by':'operating_unit_id'}"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
        </data>
    </field>
</record>

<record id="work_program_occurrence_view_tree_ou" model="ir.ui.view">
    <field name="name">work_program_occurrence tree - operating unit</field>
    <field name="model">work_program_occurrence</field>
    <field
            name="inherit_id"
            ref="ssi_school_work_program.work_program_occurrence_view_tree"
        />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='work_program_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                        optional="hide"
                    />
            </xpath>
        </data>
    </field>
</record>
</odoo>
