<odoo>
<record id="work_program_operating_unit_group" model="res.groups">
    <field name="name">Operating Unit</field>
    <field
            name="category_id"
            ref="ssi_school_work_program.work_program_data_ownership_module_category"
        />
</record>

<!-- Extend (not replace) the Company group so its members are scoped to
     their own operating units. -->
<record id="ssi_school_work_program.work_program_company_group" model="res.groups">
    <field name="implied_ids" eval="[(4, ref('work_program_operating_unit_group'))]" />
</record>
</odoo>
