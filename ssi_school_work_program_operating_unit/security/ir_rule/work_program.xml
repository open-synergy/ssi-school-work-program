<odoo>
<record id="work_program_rule_ou" model="ir.rule">
    <field name="name">Work Program - Responsible to operating unit data</field>
    <field name="model_id" ref="ssi_school_work_program.model_work_program" />
    <field name="groups" eval="[(4, ref('work_program_operating_unit_group'))]" />
    <field
            name="domain_force"
        >[('operating_unit_id','in',[g.id for g in user.operating_unit_ids])]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>

<record id="work_program_occurrence_rule_ou" model="ir.rule">
    <field
            name="name"
        >Work Program Occurrence - Responsible to operating unit data</field>
    <field
            name="model_id"
            ref="ssi_school_work_program.model_work_program_occurrence"
        />
    <field name="groups" eval="[(4, ref('work_program_operating_unit_group'))]" />
    <field
            name="domain_force"
        >[('operating_unit_id','in',[g.id for g in user.operating_unit_ids])]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>
</odoo>
