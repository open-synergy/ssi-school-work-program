<odoo>
<record id="school_academic_year_view_form" model="ir.ui.view">
    <field name="name">school_academic_year - form (work program)</field>
    <field name="model">school_academic_year</field>
    <field name="inherit_id" ref="ssi_school.school_academic_year_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='date_end']" position="after">
                <field name="work_program_planning_deadline" />
            </xpath>
        </data>
    </field>
</record>
</odoo>
