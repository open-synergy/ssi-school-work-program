<odoo>
<record id="work_program_type_view_search" model="ir.ui.view">
    <field name="name">work_program_type - search</field>
    <field name="model">work_program_type</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_name"
                            string="Name"
                            context="{'group_by': 'name'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="work_program_type_view_tree" model="ir.ui.view">
    <field name="name">work_program_type - tree</field>
    <field name="model">work_program_type</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='name']" position="after">
                <field name="analytic_group_id" optional="hide" />
            </xpath>
        </data>
    </field>
</record>

<record id="work_program_type_view_form" model="ir.ui.view">
    <field name="name">work_program_type - form</field>
    <field name="model">work_program_type</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//notebook/page[@name='note']" position="before">
                <page name="planning" string="Planning Requirements">
                    <group name="planning_group_1" string="Required Sections">
                            <field name="require_occurrence" />
                            <field name="require_target" />
                            <field name="require_objective" />
                            <field name="require_committee" />
                            <field name="require_material" />
                            <field name="require_resource" />
                            <field name="require_need" />
                            <field name="require_rundown" />
                    </group>
                </page>
                <page name="preparation" string="Preparation">
                    <field name="preparation_template_ids" nolabel="1" colspan="4">
                        <tree>
                            <field name="sequence" widget="handle" />
                            <field name="name" />
                            <field name="lead_days" />
                        </tree>
                        <form>
                            <group name="preparation_form" colspan="4" col="2">
                                <field name="sequence" />
                                <field name="name" />
                                <field name="lead_days" />
                                <field name="description" />
                            </group>
                        </form>
                    </field>
                </page>
                <page name="evaluation" string="Evaluation">
                    <group name="evaluation_group_1">
                        <field name="require_final_evaluation" />
                    </group>
                </page>
                <page name="analytic" string="Analytic">
                    <group name="analytic_group_1">
                        <field name="analytic_group_id" />
                    </group>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="work_program_type_action" model="ir.actions.act_window">
    <field name="name">Work Program Types</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">work_program_type</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="work_program_type_menu"
        name="Types"
        parent="menu_work_program_configuration"
        action="work_program_type_action"
        groups="work_program_type_group"
        sequence="10"
    />
</odoo>
