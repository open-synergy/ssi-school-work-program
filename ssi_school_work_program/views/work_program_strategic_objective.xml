<odoo>
<record id="work_program_strategic_objective_view_search" model="ir.ui.view">
    <field name="name">work_program_strategic_objective - search</field>
    <field name="model">work_program_strategic_objective</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_name"
                            string="Name"
                            context="{'group_by': 'name'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="work_program_strategic_objective_view_tree" model="ir.ui.view">
    <field name="name">work_program_strategic_objective - tree</field>
    <field name="model">work_program_strategic_objective</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<record id="work_program_strategic_objective_view_form" model="ir.ui.view">
    <field name="name">work_program_strategic_objective - form</field>
    <field name="model">work_program_strategic_objective</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<record id="work_program_strategic_objective_action" model="ir.actions.act_window">
    <field name="name">Work Program Strategic Objectives</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">work_program_strategic_objective</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="work_program_strategic_objective_menu"
        name="Strategic Objectives"
        parent="menu_work_program_configuration"
        action="work_program_strategic_objective_action"
        groups="work_program_strategic_objective_group"
        sequence="30"
    />
</odoo>
